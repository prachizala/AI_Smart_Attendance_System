# Application & JWT Authentication
PROJECT_NAME="AI Smart Attendance System"
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for academic development)
DATABASE_URL="sqlite:///./smart_attendance.db"

# Work Geofence Perimeter Settings
# Coordinates for Shanti Business School, Shela, Ahmedabad (academic testing ground)
OFFICE_LAT=23.002217
OFFICE_LNG=72.455763
OFFICE_LATITUDE=23.002217
OFFICE_LONGITUDE=72.455763
GEOFENCE_RADIUS_M=100.0
ALLOWED_RADIUS_METERS=100.0

# Office Work Hours & Lateness Threshold
SHIFT_START="09:30"
OFFICE_START_TIME="09:30"
OFFICE_END_TIME="18:00"

# Facial Verification Tolerance (Euclidean distance threshold)
# 0.50 is strict; 0.65 allows slight lighting/angle variance
